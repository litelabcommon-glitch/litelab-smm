# ═══════════════════════════════════════════════════════════════════════════════
# LITELAB — Social Media Management, Higgsfield Visual Engine & Zoho Social Config
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LITELAB Brand Identity ───
BRAND_NAME=LITELAB
BRAND_HANDLE=@litelab.in
BRAND_WEBSITE=https://litelab.in

# ─── Higgsfield AI & Generative Providers (Primary Content Engine) ───
DEFAULT_AI_PROVIDER=higgsfield
HIGGSFIELD_IMAGE_MODEL=gpt_image_2_5
HIGGSFIELD_VIDEO_MODEL=seedance_2_5
POLLINATIONS_MODEL=flux
HF_TOKEN=
GEMINI_API_KEY=

# ─── Zoho Social (Primary Scheduler & Multi-Platform Publisher) ───
# Note: ZOHO_CLIENT_ID & ZOHO_CLIENT_SECRET auto-load from ~/.zoho-hr-mcp/credentials.json
# if left blank. Generate a Zoho Social refresh token with scope: ZohoSocial.post.ALL
ZOHO_REGION=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SOCIAL_BRAND_ID=
ZOHO_SOCIAL_PORTAL_ID=
ZOHO_DEFAULT_SCHEDULE_TIME=06:30 PM
ZOHO_SOCIAL_ALWAYS_EXPORT_CSV=true

# ─── Google Sheets (Optional Content Calendar Sync) ───
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEET_ID=

# ─── LinkedIn Direct Auto-Publishing ───
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORGANIZATION_URN=

# ─── Instagram Direct / Buffer Auto-Publishing ───
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_MODE=graph
BUFFER_PROFILE_ID=

# ─── YouTube Shorts Auto-Publishing ───
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ─── Reddit Auto-Publishing ───
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_DEFAULT_SUBREDDIT=u_Litelab

# ─── X / Twitter Auto-Publishing ───
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ─── WhatsApp Business Catalog (INR) ───
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CATALOG_ID=
WHATSAPP_CURRENCY=INR

# ─── Notifications & Webhooks ───
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
